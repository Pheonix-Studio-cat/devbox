{
  "name": "devbox",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first developer toolbox that runs entirely in your browser.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.13",
    "vitest": "^3.2.4"
  }
}
